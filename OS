SeekOS/
├── boot/
│   └── grub/
│       └── grub.cfg
├── kernel/
│   ├── kernel.c
│   └── kernel_entry.asm
├── Makefile
└── iso/
set timeout=0
set default=0

menuentry "SeekOS" {
    multiboot /boot/kernel.bin
    boot
}
; kernel_entry.asm
[bits 32]
global _start
extern kernel_main

_start:
    call kernel_main
    cli
.hang:
    hlt
    jmp .hang
// kernel.c
void kernel_main(void) {
    const char *message = "Welcome to SeekOS!";
    char *video_memory = (char *)0xb8000;

    for (int i = 0; message[i] != '\0'; ++i) {
        video_memory[i * 2] = message[i];
        video_memory[i * 2 + 1] = 0x07;  // Light grey on black
    }

    while (1) {}
}
ISO_DIR = iso
BUILD_DIR = build
KERNEL = $(BUILD_DIR)/kernel.bin

all: $(KERNEL) iso/SeekOS.iso

$(KERNEL): kernel/kernel_entry.asm kernel/kernel.c
	mkdir -p $(BUILD_DIR)
	nasm -f elf32 kernel/kernel_entry.asm -o $(BUILD_DIR)/kernel_entry.o
	gcc -m32 -ffreestanding -c kernel/kernel.c -o $(BUILD_DIR)/kernel.o
	ld -m elf_i386 -Ttext 0x1000 -o $(KERNEL) $(BUILD_DIR)/kernel_entry.o $(BUILD_DIR)/kernel.o --oformat binary

iso/SeekOS.iso: $(KERNEL)
	mkdir -p iso/boot/grub
	cp $(KERNEL) iso/boot/kernel.bin
	cp boot/grub/grub.cfg iso/boot/grub/grub.cfg
	grub-mkrescue -o iso/SeekOS.iso iso

clean:
	rm -rf $(BUILD_DIR) iso/boot/kernel.bin iso/SeekOS.iso
make
qemu-system-i386 -cdrom iso/SeekOS.iso
